# User-facing knobs now live in <STATE_DIR>/config.json. On first run the file
# is created with safe defaults; view / replace it via:
#   h0x-cli config get
#   h0x-cli config set '<full-json-payload>'
# Keys (whole-file semantics, no dotted set/get):
#   localModels.url, log.level, agent.tokenBudget, agent.maxSteps,
#   agent.toolTimeoutMs, agent.approvalLevel

# Bootstrap / optional env only. Not managed by `h0x-cli config`.
H0X_CLI_STATE_DIR=~/.h0x-cli
H0X_CLI_LLAMA_API_KEY=

# Browser (uses the already-installed Chrome/Edge on the host)
H0X_CLI_BROWSER_CHANNEL=chrome
H0X_CLI_BROWSER_HEADLESS=false
H0X_CLI_BROWSER_CDP_URL=
H0X_CLI_BROWSER_LAUNCH_TIMEOUT_MS=30000

# Skills (auto-discovered from STATE_DIR/skills and ./.h0x-cli/skills;
# legacy ./.atomic-agent/skills remains readable for migration)
H0X_CLI_SKILLS_CATALOG_BUDGET=512

# Legacy ATOMIC_AGENT_* names still work when the matching H0X_CLI_* name is absent.
