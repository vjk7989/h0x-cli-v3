# Chat llama-server URL (optional — orchestrators can start managed daemons).
# h0x names win; legacy ATOMIC_AGENT_* names remain accepted.
# H0X_CLI_EVAL_LLAMA_URL=http://127.0.0.1:19091
# ATOMIC_AGENT_EVAL_LLAMA_URL=http://127.0.0.1:19091

# Embedding daemon for local memory fabric (optional)
# H0X_CLI_EVAL_EMBED_URL=http://127.0.0.1:19092
# ATOMIC_AGENT_EVAL_EMBED_URL=http://127.0.0.1:19092

# Hugging Face token for gated GAIA download
# HF_TOKEN=hf_...

# External agent CLIs (must be on PATH when benchmarking competitors)
# HERMES_CLI=hermes
# OPENCLAW_CLI=openclaw

# Hermes custom endpoint when not using managed h0x local models
# HERMES_LLM_BASE_URL=http://127.0.0.1:19091/v1
# HERMES_LLM_MODEL=gemma-4-26b-a4b

# OpenClaw local provider (see OpenClaw docs for your install)
# OPENCLAW_LLM_BASE_URL=http://127.0.0.1:19091/v1

# Matrix filters (comma-separated agent ids: h0x-cli, atomic-agent, hermes, openclaw)
# H0X_CLI_EVAL_AGENTS=h0x-cli
# ATOMIC_AGENT_EVAL_AGENTS=atomic-agent,hermes,openclaw

# GAIA split filter: validation level subset
# H0X_CLI_GAIA_LEVEL=1
# H0X_CLI_GAIA_LIMIT=5
# H0X_CLI_GAIA_MODEL=openai/gpt-4o-mini
# ATOMIC_AGENT_GAIA_LEVEL=1
# ATOMIC_AGENT_GAIA_LIMIT=53

# OpenRouter API key (required for the h0x-cli OpenRouter adapter)
# OPENROUTER_API_KEY=sk-or-v1-...

